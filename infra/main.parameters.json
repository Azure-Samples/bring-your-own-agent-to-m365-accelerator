{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "name": {
      "value": "${AZURE_ENV_NAME}"
    },
    "location": {
      "value": "${AZURE_LOCATION}"
    },
    "tenantIdBase64Encoded": {
      "value": "${AZURE_TENANT_ID_BASE64_ENCODED}"
    },
    "localTunnelEndpoint": {
      "value": "${LOCAL_TUNNEL_ENDPOINT=}"
    },
    "devBotAppId": {
      "value": "${DEV_BOT_APP_ID=}"
    },
    "deployDevBot": {
      "value": "${DEPLOY_DEV_BOT=true}"
    }
  }
}
