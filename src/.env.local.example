# ─────────────────────────────────────────────────────────────────────────────
# Mode A - SMOKE TEST ONLY (no Azure Bot, no APIM, no SSO)
# ─────────────────────────────────────────────────────────────────────────────
# Use this only to verify the app boots and answers on its own. It does NOT go
# through APIM or perform the real SSO on-behalf-of exchange, so it is NOT a
# substitute for the dev-tunnel-behind-APIM flow (see docs/LOCAL_DEVELOPMENT.md).
# There is no per-user search token, so AI Search returns PUBLIC documents only.
#
# Usage:
#   az login
#   cp .env.local.example .env
#   uv run python main.py            # terminal 1 (agent on http://localhost:3978)
#   ../scripts/run-test-tool.sh      # terminal 2 (Test Tool / Playground UI)

# Anonymous run mode: skip JWT validation + SSO.
AGENT_AUTH_MODE=anonymous
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__ANONYMOUS_ALLOWED=true

# Leave empty so Foundry/Search use your `az login` identity (not a managed identity).
BOT_CLIENT_ID=

# Microsoft Foundry (required). Copy from a provisioned env: azd env get-values
MS_FOUNDRY_PROJECT_ENDPOINT=https://<your-foundry>.services.ai.azure.com/api/projects/<project>
MS_FOUNDRY_ORCHESTRATOR_MODEL_DEPLOYMENT_NAME=gpt-5.4

# Azure AI Search (optional). Leave empty to answer from the model only. If set,
# results are limited to public documents (no per-user ACL token in this mode).
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX=secure-docs

PORT=3978
