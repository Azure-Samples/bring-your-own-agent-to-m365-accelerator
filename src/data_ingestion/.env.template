# Azure AI Search endpoint (e.g. https://<your-service>.search.windows.net)
AZURE_SEARCH_ENDPOINT=

# (Optional) Index name – defaults to "documents-index"
# AZURE_SEARCH_INDEX_NAME=documents-index

# (Optional) Admin API key – if not set, DefaultAzureCredential is used (recommended)
# AZURE_SEARCH_API_KEY=

# Azure AI Foundry project endpoint
AZURE_AI_FOUNDRY_ENDPOINT=https://<foundry-project-name>.openai.azure.com

# (Optional) Embedding model deployment name – defaults to "text-embedding-3-small"
AZURE_AI_FOUNDRY_EMBEDDING_DEPLOYMENT=text-embedding-3-small
