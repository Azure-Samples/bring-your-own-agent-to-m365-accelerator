# Single template used for both local modes.
# scripts/gen_local_env.sh fills ${{...}} with azd env values and mode-specific settings:
# - DEPLOY_DEV_BOT=true  -> full dev flow (Bot Service dev + APIM + SSO)
# - DEPLOY_DEV_BOT=false -> anonymous smoke mode

# Runtime mode
AGENT_AUTH_MODE=${{AGENT_AUTH_MODE}}
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__ANONYMOUS_ALLOWED=${{ANONYMOUS_ALLOWED}}

# Bot connector auth settings (filled when DEPLOY_DEV_BOT=true)
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=${{CONNECTIONS_CLIENTID}}
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTSECRET=${{CONNECTIONS_CLIENTSECRET}}
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID=${{AZURE_TENANT_ID}}
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__AUTHTYPE=${{CONNECTIONS_AUTHTYPE}}

# SSO handler — maps to Azure Bot OAuth connection for user authentication
AGENTAPPLICATION__USERAUTHORIZATION__HANDLERS__SSO__SETTINGS__AZUREBOTOAUTHCONNECTIONNAME=default_user_access_token
AGENTAPPLICATION__USERAUTHORIZATION__HANDLERS__SEARCH__SETTINGS__AZUREBOTOAUTHCONNECTIONNAME=search_access_token

# Connection map (required by M365 Agents SDK)
CONNECTIONSMAP__0__CONNECTION=SERVICE_CONNECTION
CONNECTIONSMAP__0__SERVICEURL=*

# Foundry + Search data-plane use your `az login` identity (BOT_CLIENT_ID empty).
MS_FOUNDRY_PROJECT_ENDPOINT=${{FOUNDRY_PROJECT_ENDPOINT}}
MS_FOUNDRY_ORCHESTRATOR_MODEL_DEPLOYMENT_NAME=${{MS_FOUNDRY_ORCHESTRATOR_MODEL_DEPLOYMENT_NAME}}
AZURE_SEARCH_ENDPOINT=${{AZURE_SEARCH_ENDPOINT}}
AZURE_SEARCH_INDEX=${{AZURE_SEARCH_INDEX}}

PORT=3978

## CONTOSO USER GROUPS (for testing purposes)
# One Entra group is enough for the POC ("restricted docs") in addition to docs with group_ids=["all"].
CONTOSO_GROUP_MARKETING_ID=<your-group-id>