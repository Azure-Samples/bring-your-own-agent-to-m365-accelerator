# Reference of the env produced by scripts/gen_local_env.sh for the
# dev-tunnel-behind-APIM local run (the only supported local test path).
#
# Do NOT fill this in by hand. Generate the real src/.env with:
#   ./scripts/provision_dev_bot.sh   # once: dev bot app + secret -> azd env
#   ./scripts/devtunnel.sh           # persistent tunnel -> azd env (LOCAL_TUNNEL_ENDPOINT)
#   azd provision                    # APIM backend -> tunnel, dev bot, OAuth connections
#   ./scripts/gen_local_env.sh       # writes src/.env from azd outputs
#
# The agent then runs locally with the FULL flow: Teams/Copilot -> dev Bot Service
# -> APIM (validate-jwt) -> dev tunnel -> local app -> real SSO (per-user Search token
# carrying your Entra group ACLs) -> Foundry. No path bypasses SSO or APIM.

# Single-tenant dev bot (Bot Connector auth via client secret)
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=<dev-bot-app-id>
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTSECRET=<dev-bot-secret>
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID=<tenant-id>
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__AUTHTYPE=ClientSecret

# SSO + per-user Search OAuth handlers (Bot Service OAuth connections)
AGENTAPPLICATION__USERAUTHORIZATION__HANDLERS__SSO__SETTINGS__AZUREBOTOAUTHCONNECTIONNAME=default_user_access_token
AGENTAPPLICATION__USERAUTHORIZATION__HANDLERS__SEARCH__SETTINGS__AZUREBOTOAUTHCONNECTIONNAME=search_access_token

# Connection map (required by the M365 Agents SDK)
CONNECTIONSMAP__0__CONNECTION=SERVICE_CONNECTION
CONNECTIONSMAP__0__SERVICEURL=*

# Foundry + Search data-plane use your `az login` identity (BOT_CLIENT_ID empty).
BOT_CLIENT_ID=
MS_FOUNDRY_PROJECT_ENDPOINT=<from azd: FOUNDRY_PROJECT_ENDPOINT>
MS_FOUNDRY_ORCHESTRATOR_MODEL_DEPLOYMENT_NAME=gpt-5.4
AZURE_SEARCH_ENDPOINT=<from azd: AZURE_SEARCH_ENDPOINT>
AZURE_SEARCH_INDEX=secure-docs

PORT=3978
