CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=<uami-client-id>
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID=<tenant-id>

# Only on deployment: CONNECTIONS__SERVICE_CONNECTION__SETTINGS__AUTHTYPE=UserManagedIdentity

# OBO connection for AI Search per-user ACLs (app registration with client secret)
CONNECTIONS__OBO_CONNECTION__SETTINGS__CLIENTID=<app-registration-client-id>
CONNECTIONS__OBO_CONNECTION__SETTINGS__CLIENTSECRET=<app-registration-client-secret>
CONNECTIONS__OBO_CONNECTION__SETTINGS__TENANTID=<tenant-id>

# Foundry agent configuration
MS_FOUNDRY_PROJECT_ENDPOINT=https://<your-ai-foundry-resource-name>.services.ai.azure.com/api/projects/<your-project-id>
MS_FOUNDRY_ORCHESTRATOR_MODEL_DEPLOYMENT_NAME=<model-deployment-name>

# SSO handler — maps to Azure Bot OAuth connection for user authentication
AGENTAPPLICATION__USERAUTHORIZATION__HANDLERS__AIFOUNDRY__SETTINGS__AZUREBOTOAUTHCONNECTIONNAME=ai_foundry_access_token
AGENTAPPLICATION__USERAUTHORIZATION__HANDLERS__SSO__SETTINGS__AZUREBOTOAUTHCONNECTIONNAME=default_user_access_token

# Connection map (required by M365 Agents SDK)
CONNECTIONSMAP__0__CONNECTION=SERVICE_CONNECTION
CONNECTIONSMAP__0__SERVICEURL=*

# AI Search
AZURE_SEARCH_ENDPOINT=https://<your-search-service>.search.windows.net
AZURE_SEARCH_INDEX=secure-docs
